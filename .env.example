# Active stack: Meta models, SerpAPI search, Google Compute Engine hosting.
# Copy to .env. Never put credentials in NEXT_PUBLIC_* variables.
RELAY_MODE=fixture
DATABASE_URL=postgres://relay:relay@127.0.0.1:5432/relay
RELAY_LOCAL_DB=true
WORKSPACE_ID=hacktx-demo
WORKSPACE_NAME=HackTX workspace
APP_URL=http://127.0.0.1:3000
MUSE_API_KEY=
MUSE_BASE_URL=https://api.meta.ai/v1
MUSE_MODEL=muse-spark-1.3
SERPAPI_API_KEY=
# Private disk directory; Docker uses its persistent artifacts volume.
RELAY_ARTIFACT_DIR=.data/artifacts
# Local test allowance only. No payments or monetary value.
INITIAL_TEST_CREDITS=100
MODEL_INPUT_USD_PER_MILLION=0
MODEL_OUTPUT_USD_PER_MILLION=0
# Required for deployed Compose. Generate each secret separately.
# Use a hex database password so the generated database URL needs no escaping.
POSTGRES_PASSWORD=
DASHBOARD_PASSWORD=
SESSION_SECRET=
CONNECTOR_SECRET=
CONNECTOR_URL=http://127.0.0.1:3101/mcp
RELAY_DOMAIN=relay.example.tech
RELAY_IMAGE=relay:local
