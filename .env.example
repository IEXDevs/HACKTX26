# ---------------------------------------------------------------------------
# Agent OS — environment
# ---------------------------------------------------------------------------

# Supabase: copy the pooled Postgres URI from the project's Connect panel.
# Use the database password here, not the Supabase service-role API key.
# Local development uses embedded Postgres. Cloud Run requires a remote URL.
DATABASE_URL="pglite://./.data/postgres"

# 32-byte key, base64, used to encrypt connector credentials at rest (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# If unset, a dev key is derived and a warning is logged at boot.
CREDENTIAL_ENCRYPTION_KEY=""

# Absolute or repo-relative root for per-agent sandboxed filesystems.
# Defaults to <repo>/.runtime/workspaces
SANDBOX_ROOT=""

# Agent commands run in this local Docker image. Build it with pnpm sandbox:build.
# No host execution fallback. An empty value uses astronom-sandbox:local.
SANDBOX_IMAGE="astronom-sandbox:local"

# Hosted command execution uses the private worker's Docker daemon over TLS.
# Leave these unset locally to use the local Docker daemon.
DOCKER_HOST=""
DOCKER_TLS_VERIFY=""
DOCKER_CERT_PATH=""

# ---------------------------------------------------------------------------
# Model gateway
# ---------------------------------------------------------------------------
# scripted  -> deterministic local executor, no network, no keys (default)
# openai    -> any OpenAI-compatible /chat/completions endpoint
# anthropic -> Anthropic Messages API
MODEL_GATEWAY="scripted"

OPENAI_API_KEY=""
# Defaults to the Meta Model API (https://api.meta.ai/v1) when unset; use
# https://api.openai.com/v1 for OpenAI.
OPENAI_BASE_URL="https://api.meta.ai/v1"

ANTHROPIC_API_KEY=""
ANTHROPIC_BASE_URL="https://api.anthropic.com"

# ---------------------------------------------------------------------------
# Runtime policy defaults
# ---------------------------------------------------------------------------
# Hard ceiling per run, in USD. Exceeding it halts the run.
RUN_BUDGET_USD="2.50"
# Max tool-calling steps per subagent before the runtime forces a handoff.
MAX_STEPS_PER_AGENT="32"
# Max concurrently active subagents inside one orchestrator run.
MAX_CONCURRENT_SUBAGENTS="4"

# ---------------------------------------------------------------------------
# Supabase (Google login, usage ledger, prompt traces)
# ---------------------------------------------------------------------------
# Create a project, run supabase/schema.sql, enable the Google provider, then
# add http://localhost:3000/auth/callback as a redirect URL.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ---------------------------------------------------------------------------
# Connectors
# ---------------------------------------------------------------------------
# Composio (https://app.composio.dev) — per-user OAuth for GitHub, Gmail, Slack, …
COMPOSIO_API_KEY=""
# SerpAPI — public web search tool for agents (blocked on confidential/restricted runs)
SERPAPI_API_KEY=""

# ---------------------------------------------------------------------------
# Gemini (server only)
# ---------------------------------------------------------------------------
# Astro voice builder, agent voice lines, and workflow videos. The browser only
# ever gets short-lived Live tokens minted from this key.
GEMINI_API_KEY=""
