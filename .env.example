# Copy to .env. No secrets belong in NEXT_PUBLIC_* variables.
RELAY_MODE=fixture
DATABASE_URL=postgres://relay:relay@127.0.0.1:5432/relay
# npm run dev starts a durable local PostgreSQL-compatible PGlite server on 5432.
# Set RELAY_LOCAL_DB=false to use an existing PostgreSQL/Tiger Data database.
RELAY_LOCAL_DB=true
# Set true for Tiger Data / TimescaleDB. Keep false for embedded local development.
TIMESCALE_ENABLED=false
WORKSPACE_ID=hacktx-demo
WORKSPACE_NAME=HackTX workspace
# Required outside loopback development. Generate with openssl rand -hex 32.
DASHBOARD_PASSWORD=
SESSION_SECRET=
CONNECTOR_SECRET=
CONNECTOR_URL=http://127.0.0.1:3101/mcp
APP_URL=http://localhost:3000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MUSE_API_KEY=
MUSE_BASE_URL=https://api.meta.ai/v1
MUSE_MODEL=muse-spark-1.3
SERPAPI_API_KEY=
# Snowflake OAuth token with read access only to the scoped demo view.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_TOKEN=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=RELAY
SNOWFLAKE_SCHEMA=PUBLIC
GCS_BUCKET=
GOOGLE_APPLICATION_CREDENTIALS=
# Devnet only. No mainnet option. A real recipient public key is required.
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_RECIPIENT=
# Test credits, never money. One run costs one test credit.
INITIAL_TEST_CREDITS=100
MODEL_INPUT_USD_PER_MILLION=0
MODEL_OUTPUT_USD_PER_MILLION=0
# Production Compose: real domain, pinned image tag, managed Tiger Data URL.
RELAY_DOMAIN=relay.example.tech
RELAY_IMAGE=relay:local
