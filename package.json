{
  "name": "agent-os",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "pnpm --filter @agent-os/web dev",
    "build": "pnpm --filter @agent-os/web build",
    "start": "pnpm --filter @agent-os/web start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @agent-os/web db:generate",
    "db:push": "pnpm --filter @agent-os/web db:push",
    "db:seed": "pnpm --filter @agent-os/web db:seed",
    "db:reset": "pnpm --filter @agent-os/web db:reset",
    "db:purge-sample": "pnpm --filter @agent-os/web db:purge-sample",
    "lint": "eslint . --max-warnings=0",
    "sandbox:build": "docker build -t astronom-sandbox:local sandbox",
    "sandbox:verify": "node scripts/verify-sandbox.mjs",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.72.0"
  }
}
